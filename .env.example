# Frontend (Vite build vars; optional — otherwise /api/config is used)
VITE_SITE_URL=https://www.zzsky.com
VITE_TURNSTILE_SITE_KEY=
# Optional: R2 / CDN origin for large videos (no trailing slash). Pages file limit is 25 MiB.
# VITE_MEDIA_BASE=https://cdn.yourdomain.com

# —— Cloudflare Pages → Settings → Variables and Secrets ——
# TURNSTILE_SITE_KEY= (public Site Key, returned by /api/config)
# TURNSTILE_SECRET_KEY= (Secret Key, server-only)
# RESEND_API_KEY=
# EMAIL_FROM=ZZSKY Quote <noreply@your-domain.com>
# NOTIFY_EMAIL=sales@aorelaser.cn
# ADMIN_API_KEY=
# ALLOWED_ORIGINS=https://www.zzsky.com,https://xxx.pages.dev
# CUSTOMER_AUTO_REPLY=true
# RATE_LIMIT=5
# Binding: QUOTES_KV → KV namespace
